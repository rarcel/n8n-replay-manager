# Replace all values with your existing Traefik installation settings.
N8N_PUBLIC_HOST=n8n.example.com
TRAEFIK_NETWORK=traefik-public
TRAEFIK_HTTPS_ENTRYPOINT=https
# Must be greater than the existing n8n router for this host/path.
REPLAY_ROUTER_PRIORITY=1000
# Optional: only when using compose.traefik-acme.yaml.
# TRAEFIK_CERTRESOLVER=your-existing-resolver
