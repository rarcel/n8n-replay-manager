# Adapt to your existing infrastructure. These are placeholders, not production values.
N8N_PUBLIC_HOST=n8n.example.invalid
TRAEFIK_NETWORK=your-existing-traefik-network
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Must be greater than the existing n8n router for this host/path.
REPLAY_ROUTER_PRIORITY=1000
# Only required with compose.traefik-acme.yaml.
TRAEFIK_CERT_RESOLVER=your-existing-resolver
