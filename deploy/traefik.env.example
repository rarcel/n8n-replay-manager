# Infrastructure supplied by the user; verify priority against the existing POC.
N8N_PUBLIC_HOST=n8n.rarcel.net
TRAEFIK_NETWORK=rproxy
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Must be greater than the existing n8n router for this host/path.
REPLAY_ROUTER_PRIORITY=1000
# Existing Vault-issued certificates are configured in Traefik. No ACME overlay.
